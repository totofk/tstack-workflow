#!/usr/bin/env python3
"""envrun — use .env values without Claude ever seeing them.

    envrun [--env-file FILE] <dir> -- <command...>

Loads <dir>/.env (or FILE) into the child's environment only, runs the
command, and rewrites stdout/stderr so every loaded secret value (exact
string, longest first; also the password part of user:pass@ URLs) appears
as <masked:KEY>. NEXT_PUBLIC_* values are public by definition and pass
through. Exit code is the child's. Pair: ~/.claude/scripts/secret-read-gate.py
lets `envrun …` commands through the gate.
"""
import os, re, subprocess, sys

PUBLIC_PREFIX = "NEXT_PUBLIC_"
MIN_LEN = 6  # shorter values (flags, ports, "true") are not worth masking and would shred output


def parse_env(path):
    out = {}
    for raw in open(path, errors="replace"):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:]
        if "=" not in line:
            continue
        k, v = line.split("=", 1)
        k, v = k.strip(), v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
            v = v[1:-1]
        elif " #" in v:
            v = v.split(" #", 1)[0].rstrip()
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k):
            out[k] = v
    return out


def mask_table(env):
    table = []
    for k, v in env.items():
        if k.startswith(PUBLIC_PREFIX) or len(v) < MIN_LEN:
            continue
        table.append((v, f"<masked:{k}>"))
        m = re.match(r"[a-z][a-z0-9+.-]*://[^:/@\s]+:([^@/\s]+)@", v)
        if m and len(m.group(1)) >= MIN_LEN:
            table.append((m.group(1), f"<masked:{k}.password>"))
    table.sort(key=lambda t: -len(t[0]))
    return table


def scrub(text, table):
    for val, rep in table:
        text = text.replace(val, rep)
    return text


def main():
    args = sys.argv[1:]
    env_file = None
    if args[:1] == ["--env-file"]:
        env_file, args = args[1], args[2:]
    if "--" not in args or len(args) < 3:
        sys.exit(__doc__)
    d = args[0]
    cmd = args[args.index("--") + 1:]
    path = env_file or os.path.join(d, ".env")
    loaded = parse_env(path)
    env = dict(os.environ, **loaded)
    table = mask_table(loaded)
    p = subprocess.run(cmd, cwd=d, env=env, capture_output=True, text=True, errors="replace")
    sys.stdout.write(scrub(p.stdout, table))
    sys.stderr.write(scrub(p.stderr, table))
    sys.exit(p.returncode)


if __name__ == "__main__":
    main()
