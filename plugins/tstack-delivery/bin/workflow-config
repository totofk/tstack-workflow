#!/usr/bin/env python3
"""workflow-config — print the repository's delivery config merged over defaults.

Usage:
  workflow-config            # full merged JSON
  workflow-config base       # one value (dotted path: launch.entry, title.feature)

Reads <git toplevel>/.claude/workflow.json (or ./.claude/workflow.json outside git).
Missing file or key = the default below. Unknown keys pass through untouched.
"""
import json
import os
import subprocess
import sys

DEFAULTS = {
    "base": "develop",
    "protected": ["main", "master", "develop"],
    "assignee": "@me",
    "title": {
        "feature": "{type}: {summary}",
        "bugfix": "fix: {summary}",
        "hotfix": "hotfix: {summary}",
    },
    "acceptance": "brief",
    "launch": {"entry": "wt-{port}", "ports": [3001, 3002]},
    "worktree": ".worktrees/wt-{port}",
    "reviewer": None,
}


def repo_root():
    try:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except Exception:
        pass
    return os.getcwd()


def merge(base, over):
    out = dict(base)
    for k, v in (over or {}).items():
        out[k] = merge(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return out


def main():
    path = os.path.join(repo_root(), ".claude", "workflow.json")
    user = {}
    if os.path.isfile(path):
        try:
            with open(path, encoding="utf-8") as f:
                user = json.load(f)
        except (OSError, ValueError) as e:
            print(f"workflow-config: cannot read {path}: {e}", file=sys.stderr)
            return 1
    cfg = merge(DEFAULTS, user)
    cfg["_source"] = path if user else "defaults"
    if len(sys.argv) > 1:
        node = cfg
        for part in sys.argv[1].split("."):
            if not isinstance(node, dict) or part not in node:
                print(f"workflow-config: no key {sys.argv[1]}", file=sys.stderr)
                return 1
            node = node[part]
        print(node if isinstance(node, str) else json.dumps(node))
        return 0
    print(json.dumps(cfg, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
