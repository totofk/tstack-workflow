#!/usr/bin/env python3
"""workflow-config — print the repository's delivery config merged over defaults.

Usage:
  workflow-config            # full merged JSON
  workflow-config base       # one value (dotted path: launch.entry, title.feature)

Lookup order, first file found wins (paths relative to the git toplevel, or ./ outside git):
  .agents/workflow.json   shared, committed with the repository
  .claude/workflow.json   personal override, never committed
  workflows/<repo>.json   shipped by an installed plugin (a team adapter), <repo> being the
                          origin repository name, so worktrees resolve to the same file
Missing file or key = the default below. Unknown keys pass through untouched.
"""
import json
import os
import subprocess
import sys

DEFAULTS = {
    "base": "develop",
    "protected": ["main", "master", "develop"],
    "assignee": "@me",
    "title": {
        "feature": "{type}: {summary}",
        "bugfix": "fix: {summary}",
        "hotfix": "hotfix: {summary}",
    },
    "acceptance": "brief",
    "launch": {"entry": "wt-{port}", "ports": [3001, 3002]},
    "worktree": ".worktrees/wt-{port}",
    "reviewer": None,
}


def repo_root():
    try:
        r = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except Exception:
        pass
    return os.getcwd()


def repo_slug():
    """Repository name from the origin URL (git@host:owner/name.git or https://host/owner/name)."""
    try:
        r = subprocess.run(["git", "remote", "get-url", "origin"], capture_output=True, text=True, timeout=5)
        url = r.stdout.strip() if r.returncode == 0 else ""
    except Exception:
        url = ""
    if not url:
        return None
    name = url.rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1]
    return name[:-4] if name.endswith(".git") else name


def plugin_config_path(slug):
    """<installPath>/workflows/<slug>.json of the first installed plugin that ships one."""
    config_dir = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    reg = os.path.join(config_dir, "plugins", "installed_plugins.json")
    try:
        with open(reg, encoding="utf-8") as f:
            plugins = json.load(f).get("plugins", {})
    except (OSError, ValueError):
        return None
    for entries in plugins.values():
        for entry in entries if isinstance(entries, list) else []:
            candidate = os.path.join(entry.get("installPath", ""), "workflows", f"{slug}.json")
            if os.path.isfile(candidate):
                return candidate
    return None


def merge(base, over):
    out = dict(base)
    for k, v in (over or {}).items():
        out[k] = merge(base[k], v) if isinstance(v, dict) and isinstance(base.get(k), dict) else v
    return out


def main():
    root = repo_root()
    candidates = [os.path.join(root, d, "workflow.json") for d in (".agents", ".claude")]
    path = next((p for p in candidates if os.path.isfile(p)), None)
    if path is None:
        slug = repo_slug()
        path = (plugin_config_path(slug) if slug else None) or candidates[0]
    user = {}
    if os.path.isfile(path):
        try:
            with open(path, encoding="utf-8") as f:
                user = json.load(f)
        except (OSError, ValueError) as e:
            print(f"workflow-config: cannot read {path}: {e}", file=sys.stderr)
            return 1
    cfg = merge(DEFAULTS, user)
    cfg["_source"] = path if user else "defaults"
    if len(sys.argv) > 1:
        node = cfg
        for part in sys.argv[1].split("."):
            if not isinstance(node, dict) or part not in node:
                print(f"workflow-config: no key {sys.argv[1]}", file=sys.stderr)
                return 1
            node = node[part]
        print(node if isinstance(node, str) else json.dumps(node))
        return 0
    print(json.dumps(cfg, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
